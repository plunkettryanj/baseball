FROM apache/airflow:2.10.2
USER root
RUN apt-get update && apt-get install -y --no-install-recommends git \
 && rm -rf /var/lib/apt/lists/*
USER airflow
RUN pip install --no-cache-dir pybaseball clickhouse-connect pyyaml
# dbt in its own virtualenv so its dependencies can't conflict with Airflow's
RUN python -m venv /opt/airflow/dbt-venv \
 && /opt/airflow/dbt-venv/bin/pip install --no-cache-dir dbt-core dbt-clickhouse